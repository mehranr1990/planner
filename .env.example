# Database — Neon Postgres. Every environment (dev, preview, test, production) is a Neon
# branch; there is no local database process. See docs/ARCHITECTURE.md → "Database (Neon)".
#
# DATABASE_URL: the POOLED connection string (Neon's PgBouncer-style endpoint, host contains
# "-pooler"). Used by the application at runtime (src/server/db.ts). Never used for migrations.
DATABASE_URL="postgres://user:password@ep-example-123456-pooler.region.aws.neon.tech/dbname?sslmode=require"
#
# DIRECT_URL (or DATABASE_URL_UNPOOLED): the UNPOOLED connection string (no "-pooler" in the
# host). Used only by the Prisma CLI (migrate, db pull, studio) via prisma.config.ts. The
# Vercel ↔ Neon integration injects DATABASE_URL_UNPOOLED automatically; set DIRECT_URL instead
# only if you need to point the CLI somewhere the integration doesn't manage. Prisma CLI fails
# closed (a clear error, not a silent fallback to DATABASE_URL) if neither is set.
DIRECT_URL="postgres://user:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require"
# DATABASE_URL_UNPOOLED=""
#
# Only needed to run `prisma migrate dev` locally (creating new migrations) against your own
# Neon dev branch; point it at a second, disposable branch/database. Not used by `migrate deploy`.
# SHADOW_DATABASE_URL=""
#
# Client-side pg Pool size against the already-pooled Neon connection. Leave unset (pg default)
# locally; on serverless (Vercel), a small value (e.g. "3") avoids many warm instances each
# holding a large pool against Neon's connection limit.
# DATABASE_POOL_MAX=""

# Required outside local development (see e2e/support/global-setup.ts, src/server/__tests__):
# marks this run as targeting a disposable test database, so destructive test setup/cleanup
# refuses to run without it. Never set this against a Preview, Development or Production branch.
# APP_ENV="test"

# Email (invitations, password reset). Defaults to the console adapter outside production —
# leave unset for local dev. Set EMAIL_PROVIDER=resend + the two keys below to send real email.
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM=""
# Base URL used to build absolute links (invite/reset) in emails — set this in every hosted
# environment (Preview/Development/Production); defaults to localhost otherwise.
# APP_URL="http://localhost:3000"
