# PostgreSQL connection strings.
# Local dev without Docker: `npx prisma dev --name planner --detach`
# (PGlite-backed: one database per port, so the shadow DB must be its own server.)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# PGlite handles a single connection; leave unset for a real PostgreSQL server.
DATABASE_POOL_MAX="1"
